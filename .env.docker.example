# Copie para .env.docker (usado pelo docker-compose).
# PORT, UPLOADS_DIR e FIREBASE_SERVICE_ACCOUNT_PATH já são definidos no docker-compose.yml.

# Banco de dados — escolha UMA opção:
# 1) MongoDB Atlas (padrão)
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/nome_do_banco
# 2) MongoDB local em contêiner (subir com: docker compose --profile mongo-local up -d)
# MONGO_URI=mongodb://mongo:27017/inventario?replicaSet=rs0

# Chave de API da Web do Firebase (envio do e-mail de definição de senha e npm run token)
FIREBASE_WEB_API_KEY=
