#Copie este arquivo para .env e preencha os valores

#Configurações do Servidor
PORT=3000

#String de Conexão do MongoDB Atlas
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/nome_do_banco

#Caminho do arquivo JSON da conta de serviço do Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=credenciais/firebase-service-account.json

#Chave de API da Web do Firebase (usada pelo script npm run token)
FIREBASE_WEB_API_KEY=

#Pasta onde as fotos dos patrimônios são salvas (opcional, padrão: uploads)
UPLOADS_DIR=uploads
